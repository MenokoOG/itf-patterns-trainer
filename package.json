{
  "name": "itf-patterns-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first trainer for Chang-Hon ITF tuls with a RAG study coach. PROTOTYPE - not production.",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
    "firebase": "12.18.0",
    "jose": "6.2.10",
    "next": "16.3.4",
    "openai": "7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
